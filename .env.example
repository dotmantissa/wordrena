# Wordrena root environment (deploy + scripts). Copy to .env and fill in.
# The web app has its own web/.env.local, see web/.env.example.

# Private key of the wallet that deploys and owns the contracts, and that funds
# new player wallets. Must hold some studionet GEN.
DEPLOYER_KEY=0xyourdeployerprivatekey

# GenLayer studionet RPC (leave as is unless you are pointing elsewhere).
STUDIO_RPC=https://studio.genlayer.com/api
