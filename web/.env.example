# Wordrena web app environment. Copy to .env.local and fill in real values.
# Anything with NEXT_PUBLIC_ is exposed to the browser; everything else stays
# on the server only. Never commit the filled in version.

# ---- GenLayer network ----
STUDIO_RPC=https://studio.genlayer.com/api
NEXT_PUBLIC_STUDIO_RPC=https://studio.genlayer.com/api
NEXT_PUBLIC_CHAIN_ID=61999

# ---- Contract addresses ----
# Left blank, the server reads ../deploy/addresses.json. Set these to override.
BESTIARY_ADDRESS=
ARENA_ADDRESS=
TRIBUNAL_ADDRESS=

# ---- Privy email auth ----
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id
PRIVY_APP_SECRET=your_privy_app_secret

# ---- Custodial wallets ----
# The hot wallet that owns the contracts and funds new player wallets.
DEPLOYER_KEY=0xyourhotwalletprivatekey
# 32 bytes of hex used to encrypt each player's custodial key at rest.
# Generate with: openssl rand -hex 32
WALLET_ENCRYPTION_KEY=your_32_byte_hex_key

# ---- Sessions ----
# Signs the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=your_session_secret

# ---- Database (Neon Postgres) ----
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
